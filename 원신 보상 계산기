<!doctype html>
<html lang="ko">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>원신 할 일 목록</title>

<style>
:root{
  --bg:#f3f5f8;
  --card:#fff;
  --text:#252a33;
  --sub:#78808c;
  --line:#e4e8ed;
  --done:#aeb6c0;
}

*{
  box-sizing:border-box;
}

body{
  margin:0;
  background:linear-gradient(135deg,#eef3f7,#f8f5ef);
  font-family:system-ui,-apple-system,"Noto Sans KR",sans-serif;
  color:var(--text);
}

.app{
  max-width:760px;
  margin:auto;
  padding:22px 16px 40px;
}

.hero{
  padding:10px 4px 18px;
}

.hero h1{
  margin:0;
  font-size:28px;
}

.hero p{
  margin:6px 0 0;
  color:var(--sub);
}

.tabs{
  display:flex;
  gap:8px;
  overflow:auto;
  margin-bottom:14px;
}

.tab{
  border:1px solid var(--line);
  background:#fff;
  border-radius:999px;
  padding:9px 15px;
  white-space:nowrap;
  cursor:pointer;
}

.tab.active{
  background:#5f7f9f;
  color:#fff;
  border-color:#5f7f9f;
}

.progress{
  background:var(--card);
  border:1px solid var(--line);
  border-radius:18px;
  padding:15px;
  margin-bottom:14px;
}

.phead{
  display:flex;
  justify-content:space-between;
  font-size:14px;
  margin-bottom:9px;
}

.bar{
  height:9px;
  background:#edf0f3;
  border-radius:9px;
  overflow:hidden;
}

.fill{
  height:100%;
  background:#7898b8;
  width:0%;
  transition:.25s;
}

.card{
  background:rgba(255,255,255,.94);
  border:1px solid var(--line);
  border-radius:18px;
  padding:15px;
  margin-bottom:12px;
  box-shadow:0 5px 18px #00000008;
}

.card h2{
  font-size:16px;
  margin:0 0 10px;
}

.item{
  display:flex;
  align-items:center;
  gap:11px;
  padding:11px 2px;
  border-top:1px solid #eef0f3;
}

.item:first-of-type{
  border-top:0;
}

.item input{
  width:19px;
  height:19px;
  accent-color:#6689aa;
}
